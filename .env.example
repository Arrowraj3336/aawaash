# Use the same project URL and publishable (or anon) key in both pairs.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server only. Required for admin and other privileged operations.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Configure together if using the separate admin passcode flow.
ADMIN_PANEL_PASSCODE=
ADMIN_PASSCODE_SESSION_SECRET=
